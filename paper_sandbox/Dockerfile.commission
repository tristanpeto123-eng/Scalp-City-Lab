# Private Scalp City PAPER commissioning host: stdlib-only, GET broker calls only.
# This image deliberately ships ONLY the Python stdlib commissioning module.
# No neural trading runtime, broker POST implementation or demo/live executor.
FROM python:3.11-slim
WORKDIR /app
RUN mkdir -p /app/paper_sandbox
COPY paper_sandbox/railway_commission.py /app/paper_sandbox/railway_commission.py
COPY paper_sandbox/__init__.py /app/paper_sandbox/__init__.py
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SCALP_READ_ONLY_ACCOUNT_PREFLIGHT=NO
EXPOSE 8080
CMD ["python", "-m", "paper_sandbox.railway_commission"]
