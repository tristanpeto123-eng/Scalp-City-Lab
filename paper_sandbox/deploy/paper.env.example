# Local Pi/PC host configuration template. ALL trading disabled.
# Copy to /etc/scalp-city/paper.env with root owner and 0600 permissions.
# DO NOT COMMIT REAL ALPACA KEYS OR PAPER ACCOUNT IDS.
SCALP_LOCAL_MODE=OFF
SCALP_SHARED_ACCOUNT_JOURNAL_DIR=/data/scalp-paper
SCALP_DEMO_SYMBOL=LTC/USD

# Set the following via sudoedit in /etc/scalp-city/paper.env ONLY after
# personally rotating Alpaca PAPER keys and verifying broker ownership:
# SCALP_DEMO_PAPER_KEY=
# SCALP_DEMO_PAPER_SECRET=
# SCALP_DEMO_PAPER_ACCOUNT_ID=
# SCALP_DEMO_MODEL_SHA256=
# SCALP_LOCAL_MODEL_FILE=
# SCALP_LOCAL_MODEL_MANIFEST=

# NEVER set these until a distinct, explicitly owner-approved exact release:
# SCALP_LOCAL_HOST_OWNER_RELEASE=
# SCALP_LOCAL_CONFIRM_ONLY_WRITER=
# SCALP_SHARED_PAPER_APPROVED=
# SCALP_SHARED_ACCOUNT_MODE=
# SCALP_SHARED_TEACHER_WRITES_OFF=
# SCALP_DEMO_PAPER_ENABLED=
