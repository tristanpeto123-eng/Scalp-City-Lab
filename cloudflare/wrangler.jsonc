{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scalp-city-free-audit",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "AUDIT_LEDGER", "class_name": "ResearchAudit" }
    ]
  },
  "exports": {
    "ResearchAudit": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": false }
}
